<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:versionCode="1" android:versionName="0.1.0-demo">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="34" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <queries><intent><action android:name="android.speech.action.RECOGNIZE_SPEECH" /></intent></queries>
    <!-- Pleos SDK 점검 화면(SdkCheckActivity)에서 쓰는 권한 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <application android:label="카마라드 체험" android:icon="@drawable/ic_camarade" android:theme="@style/AppTheme" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name="ai.camarade.app.MainActivity" android:exported="true" android:configChanges="orientation|screenSize|smallestScreenSize" android:windowSoftInputMode="adjustResize">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <uses-library android:name="android.car" android:required="false" />
        <activity android:name="ai.camarade.app.SdkCheckActivity" android:label="카마라드 SDK 점검" android:exported="true" android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density|keyboard|keyboardHidden|navigation|locale|layoutDirection|fontScale">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
            <!-- 주행 중에도 화면을 띄울 수 있는지 시험하기 위한 Android Automotive 선언 -->
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>
    </application>
</manifest>
